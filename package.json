{
  "name": "warhammer-40k-toolkit",
  "version": "0.1.0",
  "private": true,
  "description": "Warhammer 40k toolkit: reputable-retailer price finder + combat damage calculator",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"test/**/*.test.js\"",
    "snapshot": "node scripts/snapshot-prices.js",
    "snapshot:demo": "node scripts/snapshot-prices.js _site/data/prices.json --demo",
    "build:static": "node scripts/build-static.js",
    "preview:static": "node scripts/preview-static.js",
    "import:units": "node scripts/import-units.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.21.2"
  }
}
